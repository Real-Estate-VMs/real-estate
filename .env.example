# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=Real-Estate-VMs/real-estate

# Generator
OUTPUT_DIR=/home/devops/data/raw
REPO_PATH=/home/devops/repo
STARTUP_DELAY=600
INTERVAL_SECONDS=1800
BATCH_SIZE_MIN=50
BATCH_SIZE_MAX=200

# Grafana
GRAFANA_USER=devops
GRAFANA_PASSWORD=admin

# Data Warehouse (usuário somente leitura usado pelo Grafana e pelo notebook)
DW_READER_PASSWORD=dw_leitura_lab

# Jupyter na VM bigdata (acessado por túnel SSH; usado pelo Colab como runtime local)
JUPYTER_TOKEN=realestate-lab
