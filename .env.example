# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# Caminho para a chave SSH usada pelo OpenTofu nas VMs
SSH_PUBLIC_KEY_PATH=~/.ssh/devops_lab.pub

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=Real-Estate-VMs/real-estate

# Generator
OUTPUT_DIR=/home/devops/data/raw
REPO_PATH=/home/devops/repo
STARTUP_DELAY=300
INTERVAL_SECONDS=1800
BATCH_SIZE_MIN=50
BATCH_SIZE_MAX=200

# Grafana
GRAFANA_USER=devops
GRAFANA_PASSWORD=admin
