          "rawSql": "SELECT COALESCE(tipo_pt, 'TOTAL') AS \"Tipo\", round(avg(preco_m2) FILTER (WHERE regiao = 'Nobre')) AS \"Nobre\", round(avg(preco_m2) FILTER (WHERE regiao = 'Intermediária')) AS \"Intermediária\", round(avg(preco_m2) FILTER (WHERE regiao = 'Periférica')) AS \"Periférica\", round(avg(preco_m2)) AS \"Todas\" FROM dw.vw_imoveis WHERE regiao IN ($regiao) AND tipo_pt IN ($tipo) AND vendido IN ($situacao) GROUP BY ROLLUP (tipo_pt) ORDER BY GROUPING(tipo_pt), 1"
        }
      ]
    },
