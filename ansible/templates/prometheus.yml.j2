global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: "generator"
    static_configs:
      - targets: ["{{ groups['generator'][0] }}:9100"]

  - job_name: "processing"
    static_configs:
      - targets: ["{{ groups['processing'][0] }}:9100"]

  - job_name: "bigdata"
    static_configs:
      - targets: ["{{ groups['bigdata'][0] }}:9100"]

  - job_name: "monitoring"
    static_configs:
      - targets: ["localhost:9100"]
